# EtherNet/IP MCP server settings. Every variable is optional; defaults are shown.
#
# How settings are read (the process environment always wins):
# - Without --env-file, the server loads only ethernetip-python/.env of a source
#   checkout: never a .env in the working directory or a parent directory, and
#   none at all for an installed package. That file may set only ENIP_* and
#   TAG_MAP_FILE; ENIP_WRITES_ENABLED, ENIP_SYSTEM_CMDS_ENABLED and any other
#   variable in it are ignored (any letter case), with a warning on stderr.
# - To enable writes from a file, copy this one somewhere you control and pass
#   it explicitly: ethernetip-mcp --env-file /path/to/eip.env
#   (or set the switches in the MCP client's "env").

# --- Connection -------------------------------------------------------------
# Controller IPv4 address or host name (may include :port). IPv6 only on the JSON bridge.
ENIP_HOST=127.0.0.1
# TCP port: 44818 for a controller, 5025 for the mock PLC.
ENIP_PORT=44818
# Processor slot in the chassis (not used with ENIP_PATH or ENIP_MICRO800).
ENIP_SLOT=0
# Full CIP route, e.g. 10.0.0.5/backplane/2; overrides ENIP_HOST and ENIP_SLOT.
# ENIP_PATH=
# Target is a Micro800 (no slot; refused if the controller is not a 2080-*).
ENIP_MICRO800=false
# Talk to the mock PLC's JSON-over-TCP bridge instead of CIP.
ENIP_JSON_BRIDGE=false

# --- Timing -----------------------------------------------------------------
# Socket timeout (CIP) or per-request limit (JSON bridge), seconds.
ENIP_TIMEOUT=5
# Connection-level retries; writes are never re-sent once they may have gone out.
ENIP_MAX_RETRIES=3
# Retry n waits this x 2^(n-1) seconds, at most 30 s per wait.
ENIP_RETRY_BACKOFF_BASE=0.5
# Before a write on a CIP session idle this long (seconds), probe it and reconnect if needed.
ENIP_WRITE_PROBE_IDLE=10

# --- Tag map and logging ----------------------------------------------------
# JSON file of tag aliases with optional scaling.
# TAG_MAP_FILE=
# Debug logging (including pycomm3) on stderr.
ENIP_DEBUG=false

# --- Safety switches: honoured only from the environment or --env-file -------
# Allow the write tools.
ENIP_WRITES_ENABLED=false
# Allow set_plc_time (also needs ENIP_WRITES_ENABLED=true).
ENIP_SYSTEM_CMDS_ENABLED=false
