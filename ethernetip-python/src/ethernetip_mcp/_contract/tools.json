            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_connection_status",
      "description": "Report the configured target and the outcome of the last exchange, without contacting the device.\n\n        Use ping to test the device now.\n        ",
      "inputSchema": {
        "properties": {},
