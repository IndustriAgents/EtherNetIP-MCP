    {
      "name": "set_plc_time",
      "description": "Set the controller's wall clock to this host's current time.\n\n        Refused unless both ENIP_WRITES_ENABLED=true and ENIP_SYSTEM_CMDS_ENABLED=true.\n        Not retried once sent: if the reply is lost, the error says the clock\n        may have been set.\n        ",
      "inputSchema": {
        "properties": {},
