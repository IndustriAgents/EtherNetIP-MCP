{
  "schemaVersion": 1,
  "protocol": "ethernetip",
  "transport": "stdio",
  "tools": [
    {
      "name": "read_tags",
      "description": "Select one target mode and provide only its parameters.\n\ntag: Read one tag from the controller.\n\n        Returns data {tag, value, data_type}. With `count`, reads that many array\n        elements and returns them as a list (same as read_array). Fails with\n        success=false if the controller rejects the tag.\n        \n\nbatch: Read several tags in one call.\n\n        data.results has one {tag, value, data_type, error} entry per tag, in\n        order. success is true only if every read succeeded.\n        \n\nalias: Read the tag behind a tag-map alias, converted to engineering units if the alias defines scaling.\n\n        data.raw_value is the controller value, data.value the scaled one.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tag_name": {
            "description": "Controller tag, e.g. 'MotorSpeed' or 'Program:MainProgram.MotorSpeed'. Array elements and members use Logix syntax: 'Tank_Levels[2]', 'Conveyor_Status.Running'.",
            "minLength": 1,
            "title": "Tag Name",
            "type": "string"
          },
          "count": {
            "anyOf": [
              {
                "description": "Number of consecutive array elements, starting at the tag's index.",
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Count",
            "description": "Number of consecutive array elements, starting at the tag's index."
          },
          "target": {
            "anyOf": [
              {
                "const": "tag",
                "type": "string"
              },
              {
                "const": "batch",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "tags": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Tags",
            "type": "array",
            "description": "tags for the selected operation; see its mode description."
          },
          "alias": {
            "description": "Alias defined in the TAG_MAP_FILE tag map.",
            "minLength": 1,
            "title": "Alias",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "tag_name": {
                "description": "Controller tag, e.g. 'MotorSpeed' or 'Program:MainProgram.MotorSpeed'. Array elements and members use Logix syntax: 'Tank_Levels[2]', 'Conveyor_Status.Running'.",
                "minLength": 1,
                "title": "Tag Name",
                "type": "string"
              },
              "count": {
                "anyOf": [
                  {
                    "description": "Number of consecutive array elements, starting at the tag's index.",
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Count"
              },
              "target": {
                "const": "tag",
                "type": "string"
              }
            },
            "required": [
              "tag_name",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "tags": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "title": "Tags",
                "type": "array"
              },
              "target": {
                "const": "batch",
                "type": "string"
              }
            },
            "required": [
              "tags",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "description": "Alias defined in the TAG_MAP_FILE tag map.",
                "minLength": 1,
                "title": "Alias",
                "type": "string"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "write_tags",
      "description": "Select one target mode and provide only its parameters.\n\ntag: Write one tag on the controller. Refused unless ENIP_WRITES_ENABLED=true.\n\n        Sent at most once: if the reply is lost, the result is success=false\n        with meta.outcome='unknown' (the write may have been applied; read the\n        tag back before writing again).\n\n        `value` is a number, boolean, string, list (written to consecutive array\n        elements) or object (structure members). On a real controller pycomm3\n        encodes the value with the controller's own type for the tag, so\n        `data_type` is only checked: the mock rejects a mismatch, and over CIP a\n        mismatch is reported in meta.warning. Writes change a running process.\n        \n\nbatch: Write several tags in one call. Refused unless ENIP_WRITES_ENABLED=true.\n\n        data.results always has one {tag, value, data_type, error, outcome,\n        request_sent} entry per payload. outcome is 'written', 'rejected' (the\n        device refused it), 'unknown' (it may have been applied but was not\n        confirmed; read it back) or 'not_sent'. success is true only if every\n        entry was written. The writes are not atomic and are never re-sent.\n        \n\nalias: Write the tag behind a tag-map alias. Refused unless ENIP_WRITES_ENABLED=true.\n\n        `value` is in engineering units if the alias defines scaling; it is then\n        converted to raw units, rounded for integer data types, before writing.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tag_name": {
            "description": "Controller tag, e.g. 'MotorSpeed' or 'Program:MainProgram.MotorSpeed'. Array elements and members use Logix syntax: 'Tank_Levels[2]', 'Conveyor_Status.Running'.",
            "minLength": 1,
            "title": "Tag Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "description": "value for the selected operation; see its mode description."
          },
          "data_type": {
            "anyOf": [
              {
                "description": "Expected Logix data type, e.g. REAL, DINT, BOOL, STRING.",
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data Type",
            "description": "Expected Logix data type, e.g. REAL, DINT, BOOL, STRING."
          },
          "target": {
            "anyOf": [
              {
                "const": "tag",
                "type": "string"
              },
              {
                "const": "batch",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "payloads": {
            "description": "Entries of the form {'tag_name': ..., 'value': ..., 'data_type': optional}.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Payloads",
            "type": "array"
          },
          "alias": {
            "description": "Alias defined in the TAG_MAP_FILE tag map.",
            "minLength": 1,
            "title": "Alias",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "tag_name": {
                "description": "Controller tag, e.g. 'MotorSpeed' or 'Program:MainProgram.MotorSpeed'. Array elements and members use Logix syntax: 'Tank_Levels[2]', 'Conveyor_Status.Running'.",
                "minLength": 1,
                "title": "Tag Name",
                "type": "string"
              },
              "value": {
                "title": "Value"
              },
              "data_type": {
                "anyOf": [
                  {
                    "description": "Expected Logix data type, e.g. REAL, DINT, BOOL, STRING.",
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Data Type"
              },
              "target": {
                "const": "tag",
                "type": "string"
              }
            },
            "required": [
              "tag_name",
              "value",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "payloads": {
                "description": "Entries of the form {'tag_name': ..., 'value': ..., 'data_type': optional}.",
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "minItems": 1,
                "title": "Payloads",
                "type": "array"
              },
              "target": {
                "const": "batch",
                "type": "string"
              }
            },
            "required": [
              "payloads",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
                "description": "Alias defined in the TAG_MAP_FILE tag map.",
                "minLength": 1,
                "title": "Alias",
                "type": "string"
              },
              "value": {
                "title": "Value"
              },
              "target": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": [
              "alias",
              "value",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
