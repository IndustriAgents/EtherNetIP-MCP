    {
      "name": "get_tag_list",
      "description": "List tag definitions (name and data type) uploaded from the controller.\n\n        Scope follows pycomm3: no `program` lists controller-scoped tags, '*'\n        lists all tags, and a program name lists that program's tags (named\n        'Program:<name>.<tag>').\n        ",
      "inputSchema": {
        "properties": {
          "program": {
            "anyOf": [
              {
                "description": "Omit for controller-scoped tags, '*' for every tag including program tags, or a program name such as 'MainProgram'.",
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Program",
            "description": "Omit for controller-scoped tags, '*' for every tag including program tags, or a program name such as 'MainProgram'."
          }
        },
        "title": "get_tag_listArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "list_tags",
      "description": "List the aliases defined in the TAG_MAP_FILE tag map, with their tags and scaling.",
      "inputSchema": {
        "properties": {},
        "title": "list_tagsArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
